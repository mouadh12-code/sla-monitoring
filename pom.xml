<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
  http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>
  <groupId>esprit.stage</groupId>
  <artifactId>sla-monitoring</artifactId>
  <version>1.0</version>
  <packaging>jar</packaging>
  <name>sla-monitoring</name>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
  </properties>

  <dependencies>

    <!-- Web3j - Communication avec Ethereum -->
    <dependency>
      <groupId>org.web3j</groupId>
      <artifactId>core</artifactId>
      <version>4.9.8</version>
    </dependency>

    <!-- JADE multi-agent framework.
         The JAR is not redistributed in this repository: download
         de.enflexit.jade-4.6.1.jar (see README) and place it in lib/ -->
    <dependency>
      <groupId>de.enflexit</groupId>
      <artifactId>jade</artifactId>
      <version>4.6.1</version>
      <scope>system</scope>
      <systemPath>${project.basedir}/lib/de.enflexit.jade-4.6.1.jar</systemPath>
    </dependency>

    <!-- JUnit -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>